  "k_range": "[1, N) at run time",
  "n_range": "N = 256 x IPT, IPT >= 1, measured 1024 to 32768, temp storage independent of N",
  "type_constraints": "fp32 and bf16 through the radix traits, int32 indices derived from the striped tile position",
