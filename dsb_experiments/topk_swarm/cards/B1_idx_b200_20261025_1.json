  "sorted_output_support": "not supported inherently, post-sort of k"
 },
 "correctness": {
  "oracle_passed": true,
  "cases": 286,
  "notes": "22 cells, 13 oracle cases each (4 random seeds plus the 9-pattern battery), all passed. A first build wrote every tied candidate's ticket position into the k-slot output and faulted (illegal address) in all 22 cells before any number was taken, the fix bounds the tie writes to the remaining k."
 },
