 "contract": {
  "input_location": "registers",
  "input_arrangement": "blocked",
  "output_location": "smem",
  "output_form": "indices",
  "output_sorted": true,
  "temp_storage_bytes": 39936,
  "sync_assumed": "warp convergence of the 32 lanes, the caller separates consecutive calls that reuse the temp storage or the output buffer by a __syncwarp (the harness does)",
  "sync_performed": "6 __syncwarp per call (after the per-lane run store and after each of the first four merge levels), no shuffles, no barriers, no atomics",
  "k_range": "powers of two in [32, N/2] (every merge level must split evenly over the 32 lanes), measured 64, 256 and 1024",
  "n_range": "N = 32 x IPT with IPT a power of two in [2, 64] (the per-lane Batcher network stays under the local-memory threshold of T34 at 64, N 4096 would need an in-lane merge level first), measured 512 to 2048",
  "type_constraints": "fp32 as a 64-bit word in registers (twiddled key high, inverted index low) stored as a key half and an index half in two 32-bit shared arrays, bf16 as one 32-bit word (16 twiddled key bits above the inverted 16-bit index, N at most 65536), int32 indices from the blocked position. Temp storage: two run buffers in a skewed linear layout (run stride = run length + 16 pad words + 1), 39936 bytes for fp32 N 2048 k 1024, 31744 for fp32 N 2048 k 64, 20064 for bf16 N 2048 k 1024, 9824 for bf16 N 512 k 256; at 8 warps per block the fp32 N 2048 cells exceed the 227 KB block limit in the harness throughput regime (latency only there)",
  "nan_behavior": "twiddled bitwise: a positive NaN orders above +inf, a negative NaN below -inf, the all-ones negative NaN collides with the all-zero absent-item filler word (never produced by focus-set inputs). -0.0 is folded onto +0.0 before the twiddle (one FADD for fp32, one compare and select for bf16), so both zeros form one tie class ordered by index",
  "tie_break_support": "inherent: the word order is (key descending, index ascending), the merge path takes the first run on ties and the chunk network compares full words, prefer_smaller_index is the same binary as not_guaranteed",
  "sorted_output_support": "inherent at zero extra cost: slot r holds rank r"
 },
 "correctness": {
  "oracle_passed": true,
  "cases": 528,
  "notes": "Every cell passed the full oracle battery under both requirements (random x4 seeds, tie_heavy, sorted_asc, sorted_desc, pivot_tie, all_equal, signed_zero, inf_denorm, quantized_random, relu_quantized, 22 cases per cell), exact index set under prefer_smaller_index. Six batches of the v4 build merged (labels v4_wsort_bf16, v4_wsort_f32, v4_wsort_f32lat, v4_wk64_bf16, v4_wk64_f32, v4_wk64_f32lat), all on umbriel-b200-091 in one lease, source commit 0ba868b00d; the fp32 N 2048 cells are latency only because 8 warps x 42 to 48 KB of temp storage exceed the harness throughput block's shared memory. Host emulation (approaches/W4/host_test.cpp) passes 396 cases against std::sort."
 },
