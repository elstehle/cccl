  "output_location": "smem",
  "output_form": "indices",
  "output_sorted": true,
  "temp_storage_bytes": 1024,
  "sync_assumed": "warp convergence of the 32 lanes, the caller separates calls that reuse the output buffer or the temp storage by a __syncwarp (the harness does)",
  "sync_performed": "one redux.min for the threshold, log2(IPT + 1) ballots for the prefix, one __syncwarp between the scatter and the gather, one redux.max per finish round, one redux.max for the fp32 next-word check (redux.add, max and min on the fp32 slow path, redux.add per level and two ballots per item on the overflow fallback), no barriers",
  "k_range": "[4, 128] with 2k <= N, measured 8 to 64 (k 4 and 128 built and oracle checked in the seed check only)",
  "n_range": "N = 32 x IPT, power of two, 256 to 65536 (bf16) or 32768 (fp32), measured 512 to 2048",
  "type_constraints": "bf16 (16 twiddled key bits above a 16-bit inverted index in the finish word, exact) and fp32 (top 32 - log2(capacity) twiddled key bits above the inverted buffer position, idea N4, exact after the tie pass), int32 indices derived from the striped position",
  "nan_behavior": "as W2: a NaN with the sign bit clear twiddles above +inf and is selected first, a NaN with the sign bit set is never selected, the all-ones pattern may collide with the empty-list sentinel, focus-set inputs contain no NaN",
  "tie_break_support": "inherent on the filter path (the finish word orders by key descending, index ascending) and on the fallback (ballot tickets in index order), prefer_smaller_index runs the same code and measured identical to not_guaranteed (2162 vs 2162 bf16, 2865 vs 2865 fp32 at N 1024 k 32)",
  "sorted_output_support": "descending by key on the filter path (the fp32 tie pass may reorder the last slots of the tie class), unsorted ticket order on the overflow fallback"
 },
 "correctness": {
  "oracle_passed": true,
  "cases": 338,
  "notes": "oracle battery (13 cases per adapter per cell, both requirements where measured) passed on every cell, the overflow fallback is exercised by the tie_heavy, pivot_tie, all_equal, sorted_asc and sorted_desc cases."
 },
