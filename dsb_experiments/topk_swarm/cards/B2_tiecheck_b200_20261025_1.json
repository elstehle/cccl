 "contract": {
  "input_location": "registers",
  "input_arrangement": "blocked",
  "output_location": "smem",
  "output_form": "indices",
  "output_sorted": true,
  "temp_storage_bytes": 68,
  "sync_assumed": "caller separates consecutive calls that reuse the temp storage by a block barrier",
  "sync_performed": "__syncthreads inside: 1 after the slot init plus one per round (k), fp32 adds one __syncthreads_or (a barrier with a block-wide OR) for the tie check instead of B2_packed's atomicAdd, barrier and read back, plus 1 and the re-ranked rounds on the rare tie path",
  "k_range": "[1, min(N/2, 256)] at compile time, the slot array is k words and k rounds above 256 lose to any radix path",
  "n_range": "N = Threads x IPT with IPT a power of two, IPT <= 128 for bf16 and <= 64 for fp32, N <= 65536 (16 index bits), measured N 1024 to 8192 at 256 threads",
  "type_constraints": "bf16 (twiddled 16-bit key and 16-bit inverted index in one word) and fp32 (idea N4: top 32 - log2 N key bits and the inverted index in one word, exact tie finish), int32 indices derived from the blocked position",
  "nan_behavior": "twiddled bitwise: a positive NaN ranks above +inf, a negative NaN below -inf, never in focus-set inputs. A negative NaN with all mantissa bits set at the last index packs to the empty-slot word 0 and is never selected. -0.0 is normalized to +0.0 before packing (one FADD or one HADD2 per word), so the zeros tie by index",
  "tie_break_support": "inherent: the inverted index is the low part of the packed word, prefer_smaller_index and not_guaranteed run the same binary, measured identical within 1 percent in the same lock section (raw file)",
  "sorted_output_support": "inherent: slot r is the r-th largest, the output is sorted by key descending then index ascending at no extra cost"
 },
 "correctness": {
  "oracle_passed": true,
  "cases": 234,
  "notes": "fp32 only (the bf16 path is B2_packed's and was not re-measured). Oracle battery per cell, 13 cases including pivot_tie, tie_heavy, all_equal and quantized_random which exercise the tie finish, 36 cells (18 shapes x both requirements) all passed. Control B2_packed in the same lock section, both requirements, same selection in every cell."
 },
