 "contract": {
  "input_location": "registers",
  "input_arrangement": "striped",
  "output_location": "smem",
  "output_form": "indices",
  "output_sorted": false,
  "temp_storage_bytes": 2256,
  "sync_assumed": "caller separates consecutive calls that reuse the temp storage by a block barrier",
  "sync_performed": "__syncthreads inside: 2 per radix pass plus 1 init, plus 1 in the tie phase when the candidates at the k-th key exceed the remaining k",
  "k_range": "[1, N) at run time",
  "n_range": "N = Threads x IPT, IPT 1 to 64 under prefer_smaller_index (the tie decision is a 64-bit mask per thread), measured 1024, 4096 and 16384 at 256 threads and 32768 at 512 threads, N 32768 at 256 threads is unsupported",
  "type_constraints": "fp32 and bf16 through the radix traits, int32 indices derived from the striped tile position",
  "nan_behavior": "NaN twiddles to the largest radix key and is selected first, never produced by focus-set inputs. -0.0 is normalized to +0.0 once in the prologue so both zeros form one tie class",
  "tie_break_support": "inherent under prefer_smaller_index: warp-redundant rank (knowledge base 4.5 approach C) over the exact ties after the last pass, index order on striped tiles, taken ties written at total_selected + rank. The emission ticket of the strictly selected items is one shared atomic per item on a class-indexed counter (B1_idx's spelling, T57), the ties draw and drop a ticket on the second counter. Price against B1_idx under not_guaranteed in the same session: fp32 (no ties at rank k) within 1 percent latency at N 1024 and 4096, 3.5 to 9.6 percent at N 16384, bf16 5 to 10 percent at N 1024, 12 to 24 at N 4096, 12 to 37 at N 16384, see findings",
  "sorted_output_support": "not supported inherently, post-sort of k"
 },
 "correctness": {
  "oracle_passed": true,
  "cases": 396,
  "notes": "unsupported B1_det2__B1_det__bf16_T256_N32768_K16_prefer_smaller_index | unsupported B1_det2__B1_det__bf16_T256_N32768_K64_prefer_smaller_index | unsupported B1_det2__B1_det__bf16_T256_N32768_K256_prefer_smaller_index | unsupported B1_det2__B1_det__fp32_T256_N32768_K16_prefer_smaller_index | unsupported B1_det2__B1_det__fp32_T256_N32768_K64_prefer_smaller_index | unsupported B1_det2__B1_det__fp32_T256_N32768_K256_prefer_smaller_index | 18 prefer_smaller_index cells at N 1024, 4096 and 16384 (256 threads), variant and control B1_det both under prefer_smaller_index, 27 oracle cases per cell including the five signed_zero seeds, signed_zero_boundary and pivot_tie_zero with the exact index check, all passed. The 6 cells at N 32768 and 256 threads are unsupported for both (IPT 128 exceeds the 64-bit tie mask). Control B1_det in the same lock section (harness 0.8, label d2a). The B1_det2 header is a copy of block_topk_b1.cuh in namespace topk_b1_det2 whose only functional change is the ticket hunk, the second commit of the branch adds phase stamps that compile to nothing without B1_PROFILE."
 },
