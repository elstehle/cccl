 "contract": {
  "input_location": "registers",
  "input_arrangement": "striped",
  "output_location": "smem",
  "output_form": "indices",
  "output_sorted": false,
  "temp_storage_bytes": 2256,
  "sync_assumed": "caller separates consecutive calls that reuse the temp storage by a block barrier",
  "sync_performed": "__syncthreads inside: 1 after the bracket reduction (shared with the histogram zeroing), 2 per pass (1 to 3 fixed-point passes, then key passes over the candidates on the exact fallback), none in the epilogue",
  "k_range": "[1, N) at run time",
  "n_range": "N = 256 x IPT, IPT >= 1, measured 1024 to 32768, temp storage independent of N",
  "type_constraints": "fp32 and bf16 (bf16 widened to fp32 once in the prologue), int32 indices derived from the striped tile position",
  "nan_behavior": "NaN not supported (never produced by focus-set inputs). Infinities clamp into the end bins of the fixed-point image and are ordered exactly by the key passes if the pivot falls on them. -0.0 and +0.0 share one image, they form one tie class only under prefer_smaller_index where the prologue folds -0.0 onto +0.0",
  "tie_break_support": "ticket order under not_guaranteed, warp-redundant rank under prefer_smaller_index (IPT at most 64), as B1_det",
  "sorted_output_support": "not supported inherently, post-sort of k"
 },
 "correctness": {
  "oracle_passed": true,
  "cases": 286,
  "notes": "22 cells, 13 oracle cases each, all passed in this batch. The previous build of the same source failed the inf_denorm pattern in the 4 cells with k 1024 (full bracket [-inf, +inf] clamped to [-FLT_MAX, FLT_MAX], whose width overflows fp32 and made the scale 0, so that -inf times 0 gave NaN and -inf landed in a top bin): the scale is now finite and nonzero in every case and the image is clamped on both sides. That batch (n6a) is kept under state/results/opt-B1 for its 36 valid cells and is not a card."
 },
